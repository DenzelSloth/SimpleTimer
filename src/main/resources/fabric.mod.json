{
	"schemaVersion": 1,
	"id": "simpletimer",
	"version": "${version}",
	"name": "Simple Timer",
	"description": "On-screen countdown timers with mob detection, automatic spawn tracking, 3D waypoints, and a draggable HUD. Learns respawn intervals, tracks LIVE/countdown/UP cycles, and alerts you with full-screen warnings and sounds.",
	"authors": [
		"DenzelSloth"
	],
	"contact": {
		"sources": "https://github.com/DenzelSloth/SimpleTimer"
	},
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"main": [
			{
				"adapter": "kotlin",
				"value": "com.denzelsloth.simpletimer.SimpleTimerMod"
			}
		],
		"client": [
			{
				"adapter": "kotlin",
				"value": "com.denzelsloth.simpletimer.SimpleTimerClient"
			}
		],
		"modmenu": [
			"com.denzelsloth.simpletimer.compat.ModMenuIntegration"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": ">=1.13.13+kotlin.2.4.10"
	},
	"suggests": {
		"modmenu": "*",
		"cloth-config2": "*",
		"cloth-config": "*"
	}
}
